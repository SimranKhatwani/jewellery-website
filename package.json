{
  "name": "aurelle-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AURELLE Fine Jewellery — Monorepo (Frontend & Backend)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint",
    "server": "npm --prefix backend run dev",
    "server:build": "npm --prefix backend run build",
    "seed": "npm --prefix backend run seed",
    "seed:admin": "npm --prefix backend run seed:admin"
  }
}
