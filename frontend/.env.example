# AURELLE Frontend Environment Variables

# Public Production URL
VITE_SITE_URL=https://jewellery-website-eta-flax.vercel.app

# Backend API Base URL
# For local development with Vite proxy, leave empty or set to '/api'
# For deployed frontend connecting to remote backend (e.g., Render/Railway/Heroku):
# VITE_API_BASE_URL=https://your-aurelle-backend.onrender.com/api
VITE_API_BASE_URL=/api
