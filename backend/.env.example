# AURELLE Jewellery Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aurelle?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/aurelle

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# JWT Authentication Secret (Use a strong random secret in production)
JWT_SECRET=aurelle_luxury_jwt_secret_change_in_production_2026

# JWT Token Expiry (e.g. 1d, 7d)
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Used by npm run seed:admin)
ADMIN_NAME=Aurelle Admin
ADMIN_EMAIL=admin@aurelle.com
ADMIN_PASSWORD=AurelleAdmin2026!
